# ============================================================
#  隐私保护 —— 这些绝对不能上传
# ============================================================

# 你的配置（含 OneBot 访问令牌）
config.json
config.*.json
!config.example.json

# 你的人设（可能含个人信息）—— 安装时从 persona.example.mjs 生成
src/persona.mjs
persona.mjs
!src/persona.example.mjs
!persona.example.mjs

# 运行数据（含聊天记录、QQ 号）
memories/
emotions/
proactive/
stickers/
logs/

# 视频抽帧临时目录
.video-work/

# 单实例锁（运行时生成，含本机 pid）
.bridge.lock

# B站分享状态（含分享历史）
bili/

# 显存仲裁状态
.vram-state.json

# 备份
*.bak

# ============================================================
#  声音克隆的参考音频 —— 不要上传
# ============================================================
# 这是从别人的视频/音频里截出来的音色样本：
#   · 可能涉及原声源的版权
#   · 属于个人素材，不适合公开
#
# 想用声音克隆，请自己准备 5~10 秒清晰人声，放在 voice-ref/ 下，
# 命名 ref_b.wav（或改 config.json 的 tts.sovitsRef 指向你的文件）。
# 详见 README「想让它用指定的音色说话」一节。
voice-ref/
*.wav
*.mp3
!docs/**/*.mp3

# TTS 缓存
.tts-cache/

# ============================================================
#  YOLO 模型文件（32MB 二进制，用 install 脚本下载）
# ============================================================
*.onnx

# ============================================================
#  NapCat / QQ 相关（体积大且含登录态）
# ============================================================
NapCat*/
*qq-bot-home*/
qq-data/
isolated/

# ============================================================
#  常规
# ============================================================
node_modules/
npm-debug.log*
.DS_Store
Thumbs.db
*.log
_*.png
_tmp*